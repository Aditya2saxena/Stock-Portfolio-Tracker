# Required
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/stocktracker?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

# Optional - Frontend URL for CORS
CLIENT_URL=https://your-vercel-frontend-url.vercel.app

# Optional - Reserved for future paid API provider (Twelve Data, EODHD, etc.)
# MARKET_DATA_API_KEY=your_api_key_here

NODE_ENV=production